generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PATIENT
  DOCTOR
  ADMIN
}

enum DoctorVerificationStatus {
  NOT_APPLICABLE
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                       Int                      @id @default(autoincrement())
  name                     String
  email                    String                   @unique
  passwordHash             String
  role                     UserRole                 @default(PATIENT)
  doctorVerificationStatus DoctorVerificationStatus @default(NOT_APPLICABLE)

  resetPasswordTokenHash      String?
  resetPasswordTokenExpiresAt DateTime?

  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
}

model Doctor {
  id             Int    @id @default(autoincrement())
  name           String
  specialization String
}